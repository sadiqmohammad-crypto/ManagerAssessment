rules_version = '2';

// Manager Judgment Assessment: who can read and write what.
// These rules are the only thing protecting the answer key and the results. Paste them into
// Firebase console > Firestore Database > Rules and click Publish (see SETUP.md, step 4).
//
// Administrators are listed in the "admins" collection: one document per administrator, whose ID is
// their email address in lower case. Add them by hand in the Firebase console. Nobody can add one from the site.
//
// Anyone with a verified Google account can take the test and give feedback (anyAccount() below).
// Administrators must also have a databeat.io account (signedIn() below).
// If your company's email domain is not databeat.io, change it in signedIn() below and in config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // Any Google account with a verified email: enough to take the test and give feedback.
    function anyAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }
    // A databeat.io account: administrators must have one.
    function signedIn() {
      return anyAccount()
        && request.auth.token.email.lower().matches('.*@databeat[.]io$');
    }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function isOwn(uid) { return anyAccount() && request.auth.uid == uid; }

    // Administrator list: each person can check only whether they themselves are on it. Edit it in the console.
    match /admins/{email} {
      allow get: if anyAccount() && email == me();
      allow list, create, update, delete: if false;
    }

    // Answer key, settings and locked copies of submissions: administrators only.
    match /admin/{rest=**} {
      allow read, write: if isAdmin();
    }

    // Assessment window settings: everyone signed in reads them, administrators change them.
    match /public/{docId} {
      allow read: if anyAccount();
      allow write: if isAdmin();
    }

    // Display names, so people can find the manager they give feedback on. Each person writes only their own.
    match /people/{uid} {
      allow read: if anyAccount();
      allow create, update: if isOwn(uid)
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow delete: if isAdmin() || isOwn(uid);
    }

    // Managers taking part (no answers here): everyone signed in can read it, to pick the manager they give feedback on.
    match /roster/{uid} {
      allow read: if anyAccount();
      allow create, update, delete: if isAdmin() || isOwn(uid);
    }

    // A manager's answers: that manager and administrators only.
    // After submitting, a manager can no longer change their answers, except to start a new
    // version of the questions (a different "form").
    match /responses/{uid} {
      allow read: if isAdmin() || isOwn(uid);
      allow create: if isAdmin() || (isOwn(uid) && request.resource.data.uid == uid);
      allow update: if isAdmin() || (isOwn(uid) && request.resource.data.uid == uid
        && (resource.data.status != 'submitted' || request.resource.data.form != resource.data.form));
      allow delete: if isAdmin();
    }

    // Personas shared with managers: each manager reads only their own; administrators write them.
    match /results/{uid} {
      allow read: if isAdmin() || isOwn(uid);
      allow create, update, delete: if isAdmin();
    }

    // Feedback on a manager from the manager they report to: stored against the person who gave it.
    // That person and administrators only.
    match /senior/{uid} {
      allow read: if isAdmin() || isOwn(uid);
      allow create, update: if isAdmin() || (isOwn(uid) && request.resource.data.uid == uid);
      allow delete: if isAdmin();
    }

    // Team feedback: stored against the person who gave it. That person and administrators only.
    match /survey/{uid} {
      allow read: if isAdmin() || isOwn(uid);
      allow create, update: if isAdmin() || (isOwn(uid) && request.resource.data.uid == uid);
      allow delete: if isAdmin();
    }
  }
}
